{
  "name": "neo-brutalist-blog",
  "type": "module",
  "version": "0.11.1",
  "description": "A Neo-Brutalist personal blog built with Astro",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site && npm run build:search",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "optimize-bangumi": "node scripts/optimize-bangumi-covers.mjs --move-originals",
    "fetch-bangumi": "node scripts/fetch-bangumi.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.0.5",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
