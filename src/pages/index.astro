---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Button from '@/components/Button.astro';
import Tag from '@/components/Tag.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site';
import { getFeaturedPosts, getPublishedPosts, getTagStats } from '@/lib/posts';
import { getAnimeCollection, getGameCollection } from '@/lib/media';

const allPosts = getPublishedPosts(await getCollection('posts'));
const featuredPosts = getFeaturedPosts(allPosts, 3);
const recentPosts = allPosts.slice(0, 6);
const tagStats = getTagStats(allPosts).slice(0, 8);
const animeItems = getAnimeCollection();
const gameItems = getGameCollection();
const mediaHighlights = [
  ...animeItems.slice(0, 2).map((item) => ({ ...item, kind: '追番', href: '/anime' })),
  ...gameItems.slice(0, 2).map((item) => ({ ...item, kind: '游戏', href: '/games' })),
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="home-hero" data-cursor-zone="hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="home-hero__eyebrow text-label anim-enter">{siteConfig.home.eyebrow}</p>
        <h1 class="home-hero__title anim-enter anim-delay-1">{siteConfig.home.title}</h1>
        <p class="home-hero__subtitle anim-enter anim-delay-2">{siteConfig.home.subtitle}</p>
        <div class="home-hero__actions anim-enter anim-delay-3">
          <Button label={siteConfig.home.ctaLabel} href={siteConfig.home.ctaHref} variant="primary" />
          <Button label={siteConfig.home.secondaryLabel} href={siteConfig.home.secondaryHref} variant="ghost" />
        </div>
      </div>

      <div class="home-hero__side">
        <div class="home-hero__visual anim-enter anim-delay-2">
          <div class="home-hero__grid-art" aria-hidden="true">
            <div class="home-hero__block home-hero__block--1"></div>
            <div class="home-hero__block home-hero__block--2"></div>
            <div class="home-hero__block home-hero__block--3"></div>
            <div class="home-hero__block home-hero__block--4"></div>
          </div>
        </div>

        <aside class="home-hero__panel card card--accent anim-enter anim-delay-3">
          <span class="badge">站点概览</span>
          <ul class="home-hero__stats">
            <li>
              <strong>{allPosts.length}</strong>
              <span>已发布文章</span>
            </li>
            <li>
              <strong>{tagStats.length}</strong>
              <span>正在写的主题</span>
            </li>
            <li>
              <strong>RSS</strong>
              <span>可以直接订阅更新</span>
            </li>
          </ul>
        </aside>
      </div>
    </div>
    <div class="home-hero__bar" aria-hidden="true"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="text-label section__eyebrow">Start Here</p>
          <h2 class="anim-enter">从这里开始看</h2>
        </div>
        <Button label="查看归档" href="/archive" variant="ghost" />
      </div>

      <div class="grid grid--brutalist">
        {featuredPosts.map((post, i) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/posts/${post.id}`}
            pubDate={post.data.pubDate}
            heroColor={post.data.heroColor}
            tags={post.data.tags}
            index={i}
          />
        ))}
      </div>

      {allPosts.length === 0 && (
        <div class="empty-state card card--flat">
          <p class="text-display" style="font-size: var(--text-2xl); margin-bottom: var(--space-4);">
            NO POSTS YET
          </p>
          <p>还没有文章。开始写作吧！</p>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="text-label section__eyebrow">Topics</p>
          <h2>正在写的主题</h2>
        </div>
        <Button label="订阅 RSS" href="/rss.xml" variant="ghost" />
      </div>

      <div class="topic-cloud card card--flat scroll-reveal">
        {tagStats.map((item, index) => (
          <Tag
            label={`${item.tag} · ${item.count}`}
            href={`/archive?tag=${encodeURIComponent(item.tag)}`}
            variant={index % 3 === 0 ? 'accent' : index % 3 === 1 ? 'link' : 'action'}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="text-label section__eyebrow">What You Will Find</p>
          <h2>这个站点会写什么</h2>
        </div>
      </div>

      <div class="grid grid--3">
        <div class="card card--accent scroll-reveal">
          <h3>设计判断</h3>
          <p>记录配色、排版、信息层级和可访问性的取舍，不只展示结果，也解释为什么这么做。</p>
        </div>
        <div class="card scroll-reveal">
          <h3>实现过程</h3>
          <p>把视觉语言落到 Astro、TypeScript 和 CSS 上，关注组件结构、构建方式和可维护性。</p>
        </div>
        <div class="card card--link scroll-reveal">
          <h3>个人清单</h3>
          <p>保留追番和游戏页面，但它们现在是纯静态清单，不再拖慢构建，也更适合长期维护。</p>
        </div>
      </div>
    </div>
  </section>


  <section class="section section--media">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="text-label section__eyebrow">Bangumi Shelf</p>
          <h2>最近钉到墙上的东西</h2>
        </div>
        <div class="media-links">
          <Button label="追番档案" href="/anime" variant="ghost" />
          <Button label="游戏档案" href="/games" variant="ghost" />
        </div>
      </div>

      <div class="home-media-grid">
        {mediaHighlights.map((item, index) => (
          <a href={item.href} class:list={['home-media-card', `home-media-card--${item.statusTone ?? 'neutral'}`]} style={`--home-media-rotate: ${index % 2 === 0 ? '-0.4deg' : '0.35deg'};`}>
            <span class="home-media-card__kind">{item.kind}</span>
            <div class="home-media-card__cover" aria-hidden="true">
              {item.cover ? <img src={item.cover} alt="" loading="lazy" decoding="async" /> : <span>{(item.nameCn || item.name).charAt(0)}</span>}
            </div>
            <div class="home-media-card__body">
              <h3>{item.nameCn || item.name}</h3>
              <p>{item.year || '----'} · {item.collectionType} · {item.displayScore}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--compact">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="text-label section__eyebrow">Latest</p>
          <h2>最近更新</h2>
        </div>
      </div>

      <div class="grid grid--brutalist">
        {recentPosts.filter((post) => !featuredPosts.some((fp) => fp.id === post.id)).slice(0, 3).map((post, i) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/posts/${post.id}`}
            pubDate={post.data.pubDate}
            heroColor={post.data.heroColor}
            tags={post.data.tags}
            index={i + 3}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    border-bottom: var(--border-thick);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.8fr);
    gap: var(--space-10);
    align-items: start;
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .home-hero__side {
    display: grid;
    gap: var(--space-6);
    align-self: stretch;
  }

  .home-hero__eyebrow {
    margin-bottom: var(--space-4);
  }

  .home-hero__title {
    max-width: 12ch;
    margin-bottom: var(--space-6);
  }

  .home-hero__subtitle {
    font-size: var(--text-lg);
    max-width: 44ch;
    color: var(--color-text-muted);
  }

  .home-hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .home-hero__visual {
    border: var(--border-thick);
    background:
      linear-gradient(135deg, rgba(var(--color-border-rgb), 0.04) 25%, transparent 25%) -12px 0 / 24px 24px,
      linear-gradient(225deg, rgba(var(--color-border-rgb), 0.03) 25%, transparent 25%) -12px 0 / 24px 24px,
      var(--color-surface);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-hero__grid-art {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    width: min(100%, 320px);
  }

  .home-hero__block {
    aspect-ratio: 1;
    border: var(--border-thick);
    transition: transform 0.16s steps(2, end),
                box-shadow 0.16s steps(2, end);
    cursor: pointer;
  }

  .home-hero__block:hover {
    animation-play-state: paused;
    transform: translate(-6px, -6px) rotate(0deg) !important;
    box-shadow: 14px 14px 0px 0px var(--color-border);
  }

  .home-hero__block:active {
    transform: translate(2px, 2px) rotate(0deg) !important;
    box-shadow: 2px 2px 0px 0px var(--color-border);
  }

  .home-hero__block--1 {
    background: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2deg);
    animation: home-block-drift-1 3.6s steps(5, end) infinite;
  }

  .home-hero__block--2 {
    background: var(--color-action);
    box-shadow: var(--shadow-lg);
    transform: translateY(20px) rotate(1deg);
    animation: home-block-drift-2 4.2s steps(5, end) infinite;
    animation-delay: 0.4s;
  }

  .home-hero__block--3 {
    background: var(--color-link);
    box-shadow: var(--shadow-lg);
    transform: translateY(-10px) rotate(0.5deg);
    animation: home-block-drift-3 3.8s steps(5, end) infinite;
    animation-delay: 0.9s;
  }

  .home-hero__block--4 {
    background: var(--color-border);
    box-shadow: var(--shadow-lg);
    transform: rotate(-1deg);
    animation: home-block-drift-4 4.6s steps(5, end) infinite;
    animation-delay: 0.2s;
  }

  .home-hero__stats {
    list-style: none;
    margin: var(--space-6) 0;
    display: grid;
    gap: var(--space-4);
  }

  .home-hero__stats li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-medium);
  }

  .home-hero__stats strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .home-hero__stats span {
    align-self: end;
    text-align: right;
    color: var(--color-text-muted);
  }

  .home-hero__panel-copy {
    margin-bottom: 0;
  }

  .home-hero__bar {
    height: 8px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-border) 0px,
      var(--color-border) 18px,
      var(--color-accent) 18px,
      var(--color-accent) 36px,
      var(--color-link) 36px,
      var(--color-link) 54px,
      var(--color-action) 54px,
      var(--color-action) 72px
    );
  }

  .section {
    padding: var(--space-16) 0;
  }

  .section--compact {
    padding-top: 0;
  }

  .section__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-10);
    gap: var(--space-4);
  }

  .section__header h2 {
    margin-bottom: 0;
  }

  .section__eyebrow {
    margin-bottom: var(--space-3);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16);
  }

  .topic-cloud {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @keyframes home-block-drift-1 {
    0%   { transform: rotate(-2deg) translate(0, 0); }
    20%  { transform: rotate(-1deg) translate(6px, -6px); }
    40%  { transform: rotate(-4deg) translate(-6px, -12px); }
    60%  { transform: rotate(1deg) translate(12px, -6px); }
    80%  { transform: rotate(-3deg) translate(-6px, 6px); }
    100% { transform: rotate(-2deg) translate(0, 0); }
  }

  @keyframes home-block-drift-2 {
    0%   { transform: translateY(20px) rotate(1deg); }
    20%  { transform: translate(-6px, 12px) rotate(3deg); }
    40%  { transform: translate(6px, 6px) rotate(0deg); }
    60%  { transform: translate(-12px, 24px) rotate(2deg); }
    80%  { transform: translate(6px, 18px) rotate(-1deg); }
    100% { transform: translateY(20px) rotate(1deg); }
  }

  @keyframes home-block-drift-3 {
    0%   { transform: translateY(-10px) rotate(0.5deg); }
    20%  { transform: translate(12px, -18px) rotate(-1.5deg); }
    40%  { transform: translate(-6px, -6px) rotate(2deg); }
    60%  { transform: translate(6px, -24px) rotate(-0.5deg); }
    80%  { transform: translate(-12px, -6px) rotate(2.5deg); }
    100% { transform: translateY(-10px) rotate(0.5deg); }
  }

  @keyframes home-block-drift-4 {
    0%   { transform: rotate(-1deg) translate(0, 0); }
    25%  { transform: rotate(1deg) translate(-6px, -12px); }
    50%  { transform: rotate(-3deg) translate(12px, -6px); }
    75%  { transform: rotate(2deg) translate(-6px, 12px); }
    100% { transform: rotate(-1deg) translate(0, 0); }
  }


  .media-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .home-media-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .home-media-card {
    --status-color: var(--color-border);
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
    border: var(--border-thick);
    box-shadow: var(--shadow-md);
    position: relative;
    transform: rotate(var(--home-media-rotate, 0deg));
    overflow: hidden;
    transition: transform var(--dur-fast) var(--steps-small), box-shadow var(--dur-fast) var(--steps-small);
  }

  .home-media-card--done { --status-color: var(--color-accent); }
  .home-media-card--doing { --status-color: var(--color-action); }
  .home-media-card--wish { --status-color: var(--color-link); }
  .home-media-card--paused { --status-color: var(--color-text-muted); }

  .home-media-card:hover {
    color: var(--color-text);
    text-decoration: none;
    transform: rotate(0deg) translate(-4px, -4px);
    box-shadow: 12px 12px 0 0 var(--color-border), 6px 6px 0 0 var(--status-color);
  }

  .home-media-card__kind {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 2;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    background: var(--status-color);
    color: var(--color-border);
    border: var(--border-thin);
    padding: 2px var(--space-2);
  }

  .home-media-card--doing .home-media-card__kind,
  .home-media-card--wish .home-media-card__kind,
  .home-media-card--paused .home-media-card__kind {
    color: var(--color-surface);
  }

  .home-media-card__cover {
    aspect-ratio: 4 / 3;
    border-bottom: var(--border-thick);
    background: var(--color-base);
    overflow: hidden;
  }

  .home-media-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-media-card__cover span {
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
  }

  .home-media-card__body {
    padding: var(--space-4);
  }

  .home-media-card__body h3 {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    text-transform: none;
    border: none;
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .home-media-card__body p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (max-width: 768px) {
    .home-hero__grid {
      grid-template-columns: 1fr;
      padding-top: var(--space-10);
    }

    .home-hero__visual {
      min-height: 220px;
    }

    .section__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 520px) {
    .home-media-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__block {
      animation: none;
    }
  }
</style>


