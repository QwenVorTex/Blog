---
import MediaPage from '@/components/MediaPage.astro';
import { getGameCollection } from '@/lib/media';

const gameData = getGameCollection();
---

<MediaPage
  title="游戏"
  description="TorQuen 的 Bangumi 游戏档案，包含玩过、在玩、想玩的游戏清单。"
  eyebrow="Bangumi Game Archive"
  glyph="游"
  intro="好玩的游戏在哪里，叔叔来找你了。"
  items={gameData}
  doneLabel="玩过"
  doingLabel="在玩"
  coverAspect="wide"
  emptyText="没有找到匹配的游戏。"
  filters={[
    { value: '玩过', label: '玩过' },
    { value: '在玩', label: '在玩' },
    { value: '想玩', label: '想玩' },
  ]}
/>
