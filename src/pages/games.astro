---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SortControls from '@/components/SortControls.astro';
import { getGameCollection } from '@/lib/media';

const gameData = getGameCollection();
const totalCount = gameData.length;
const doneCount = gameData.filter((g) => g.collectionType === '玩过').length;
const doingCount = gameData.filter((g) => g.collectionType === '在玩').length;
const totalScore = gameData.reduce((sum, g) => sum + g.myRate, 0);
const ratedCount = gameData.filter((g) => g.myRate > 0).length;
---

<BaseLayout title="游戏" description="TorQuen 玩过的游戏">
  <section class="media-page">
    <div class="container">
      <header class="media-page__header">
        <span class="text-giant media-page__bg-text" aria-hidden="true">游</span>
        <h1 class="text-display anim-enter">游戏</h1>
        <p class="media-page__stats anim-enter anim-delay-1">
          共 <strong>{totalCount}</strong> 款
          {ratedCount > 0 && <> · 均分 {(totalScore / ratedCount).toFixed(1)}</>}
        </p>
        <p class="media-page__intro anim-enter anim-delay-2">好游戏确实有很多，我也确实没多少时间玩它们了，sad。</p>
      </header>

      <SortControls target="#games-grid" options={[
        { value: 'default', label: '时间' },
        { value: 'alpha', label: '首字母' },
        { value: 'date', label: '年代' },
        { value: 'score', label: '评分' },
      ]} filters={[
        { value: '玩过', label: '玩过' },
        { value: '在玩', label: '在玩' },
        { value: '想玩', label: '想玩' },
      ]} />

      <div class="media-grid" id="games-grid">
        {gameData.map((game) => (
          <a
            href={game.url}
            target="_blank"
            rel="noopener noreferrer"
            class="media-card scroll-reveal"
            data-sort-name={game.label}
            data-sort-date={game.date || game.year}
            data-sort-score={game.myRate || game.score || 0}
            data-sort-status={game.collectionType}
          >
            <div class="media-card__cover" aria-hidden="true">
              {game.cover ? (
                <img
                  src={game.cover}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="media-card__img"
                />
              ) : (
                <div class="media-card__fallback">{game.name.charAt(0)}</div>
              )}
            </div>
            <div class="media-card__body">
              <h4 class="media-card__name">{game.nameCn || game.name}</h4>
              {game.nameCn && game.name !== game.nameCn && (
                <p class="media-card__label">{game.name}</p>
              )}
              <div class="media-card__meta">
                <span class="media-card__year">
                  {game.year}
                  {game.collectionType && (
                    <span class="media-card__status"> · {game.collectionType}</span>
                  )}
                </span>
                <span class="media-card__scores">
                  {game.myRate > 0 && (
                    <span class="media-card__my-rate">★{game.myRate}</span>
                  )}
                  {game.score > 0 && (
                    <span class="media-card__bgm-score">{game.score}</span>
                  )}
                </span>
              </div>
              {game.tags.length > 0 && (
                <div class="media-card__tags">
                  {game.tags.slice(0, 3).map((tag) => (
                    <span class="media-card__tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .media-page {
    padding: var(--space-16) 0;
  }

  .media-page__header {
    position: relative;
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-thick);
  }

  .media-page__bg-text {
    top: -30%;
    right: 5%;
  }

  .media-page__stats {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .media-page__intro {
    color: var(--color-text-muted);
  }

  /* ── Media Grid ── */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .media-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: var(--border-thick);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition:
      transform var(--dur-fast) var(--steps-small),
      box-shadow var(--dur-fast) var(--steps-small);
  }

  .media-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-xl);
  }

  .media-card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 var(--color-border);
  }

  .media-card__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-bottom: var(--border-thick);
    background: linear-gradient(135deg, var(--color-link) 0%, var(--color-link) 50%, var(--color-base) 50%, var(--color-base) 100%);
    overflow: hidden;
  }

  .media-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-card__fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-4xl);
    font-weight: 900;
    color: var(--color-text-muted);
  }

  .media-card__body {
    padding: var(--space-3) var(--space-4);
  }

  .media-card__name {
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    line-height: 1.4;
  }

  .media-card__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .media-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .media-card__year {
    color: var(--color-text-muted);
  }

  .media-card__status {
    color: var(--color-text-muted);
  }

  .media-card__scores {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .media-card__my-rate {
    color: var(--color-action);
    font-weight: 800;
  }

  .media-card__bgm-score {
    color: var(--color-link);
    font-weight: 600;
  }

  .media-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .media-card__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 1px var(--space-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .media-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
