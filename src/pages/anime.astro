---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SortControls from '@/components/SortControls.astro';
import { getAnimeCollection } from '@/lib/media';

const animeData = getAnimeCollection();
const totalCount = animeData.length;
const doneCount = animeData.filter((a) => a.collectionType === '看过').length;
const doingCount = animeData.filter((a) => a.collectionType === '在看').length;
const totalScore = animeData.reduce((sum, a) => sum + a.myRate, 0);
const ratedCount = animeData.filter((a) => a.myRate > 0).length;
---

<BaseLayout title="追番" description="TorQuen 的追番列表">
  <section class="media-page">
    <div class="container">
      <header class="media-page__header">
        <span class="text-giant media-page__bg-text" aria-hidden="true">番</span>
        <h1 class="text-display anim-enter">追番</h1>
        <p class="media-page__stats anim-enter anim-delay-1">
          共 <strong>{totalCount}</strong> 部 · 看过 {doneCount} · 在看 {doingCount}
          {ratedCount > 0 && <> · 均分 {(totalScore / ratedCount).toFixed(1)}</>}
        </p>
        <p class="media-page__intro anim-enter anim-delay-2">数据来自 Bangumi，一些看过后还记得的，好多都忘了。</p>
      </header>

      <SortControls target="#anime-grid" options={[
        { value: 'default', label: '时间' },
        { value: 'alpha', label: '首字母' },
        { value: 'date', label: '年代' },
        { value: 'score', label: '评分' },
      ]} filters={[
        { value: '看过', label: '看过' },
        { value: '在看', label: '在看' },
        { value: '想看', label: '想看' },
      ]} />

      <div class="media-grid" id="anime-grid">
        {animeData.map((anime) => (
          <a
            href={anime.url}
            target="_blank"
            rel="noopener noreferrer"
            class="media-card scroll-reveal"
            data-sort-name={anime.label}
            data-sort-date={anime.date || anime.year}
            data-sort-score={anime.myRate || anime.score || 0}
            data-sort-status={anime.collectionType}
          >
            <div class="media-card__cover" aria-hidden="true">
              {anime.cover ? (
                <img
                  src={anime.cover}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="media-card__img"
                />
              ) : (
                <div class="media-card__fallback">{anime.name.charAt(0)}</div>
              )}
            </div>
            <div class="media-card__body">
              <h4 class="media-card__name">{anime.nameCn || anime.name}</h4>
              {anime.nameCn && anime.name !== anime.nameCn && (
                <p class="media-card__label">{anime.name}</p>
              )}
              <div class="media-card__meta">
                <span class="media-card__year">
                  {anime.year}
                  {anime.collectionType && (
                    <span class="media-card__status"> · {anime.collectionType}</span>
                  )}
                </span>
                <span class="media-card__scores">
                  {anime.myRate > 0 && (
                    <span class="media-card__my-rate">★{anime.myRate}</span>
                  )}
                  {anime.score > 0 && (
                    <span class="media-card__bgm-score">{anime.score}</span>
                  )}
                </span>
              </div>
              {anime.tags.length > 0 && (
                <div class="media-card__tags">
                  {anime.tags.slice(0, 3).map((tag) => (
                    <span class="media-card__tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .media-page {
    padding: var(--space-16) 0;
  }

  .media-page__header {
    position: relative;
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-thick);
  }

  .media-page__bg-text {
    top: -30%;
    right: 5%;
  }

  .media-page__stats {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .media-page__intro {
    color: var(--color-text-muted);
  }

  /* ── Media Grid ── */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .media-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: var(--border-thick);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition:
      transform var(--dur-fast) var(--steps-small),
      box-shadow var(--dur-fast) var(--steps-small);
  }

  .media-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-xl);
  }

  .media-card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 var(--color-border);
  }

  .media-card__cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-bottom: var(--border-thick);
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent) 50%, var(--color-base) 50%, var(--color-base) 100%);
    overflow: hidden;
  }

  .media-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-card__fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-4xl);
    font-weight: 900;
    color: var(--color-text-muted);
  }

  .media-card__body {
    padding: var(--space-3) var(--space-4);
  }

  .media-card__name {
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    line-height: 1.4;
  }

  .media-card__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .media-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .media-card__year {
    color: var(--color-text-muted);
  }

  .media-card__status {
    color: var(--color-text-muted);
  }

  .media-card__scores {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .media-card__my-rate {
    color: var(--color-action);
    font-weight: 800;
  }

  .media-card__bgm-score {
    color: var(--color-link);
    font-weight: 600;
  }

  .media-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .media-card__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 1px var(--space-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .media-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
