---
import MediaPage from '@/components/MediaPage.astro';
import { getAnimeCollection } from '@/lib/media';

const animeData = getAnimeCollection();
---

<MediaPage
  title="追番"
  description="TorQuen 的 Bangumi 追番档案，包含看过、在看、想看的动画清单。"
  eyebrow="Bangumi Anime Archive"
  glyph="番"
  intro="数据来自 Bangumi。"
  items={animeData}
  doneLabel="看过"
  doingLabel="在看"
  coverAspect="poster"
  emptyText="没有找到匹配的动画。"
  filters={[
    { value: '看过', label: '看过' },
    { value: '在看', label: '在看' },
    { value: '想看', label: '想看' },
  ]}
/>
