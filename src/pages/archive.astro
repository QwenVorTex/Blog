---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SortControls from '@/components/SortControls.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, getTagStats } from '@/lib/posts';

const allPosts = getPublishedPosts(await getCollection('posts'));
const allTags = getTagStats(allPosts);
---

<BaseLayout title="文章归档" description="所有博客文章">
  <section class="archive">
    <div class="container">
      <header class="archive__header">
        <span class="text-giant archive__bg-num" aria-hidden="true">
          {String(allPosts.length).padStart(2, '0')}
        </span>
        <h1 class="text-display anim-enter">文章归档</h1>
        <p class="archive__count anim-enter anim-delay-1">
          共 <strong>{allPosts.length}</strong> 篇文章
        </p>
        <p class="archive__intro anim-enter anim-delay-2">
          按时间集中展示所有文章，也可以直接按主题筛选。
        </p>
      </header>

      <SortControls
        target="#posts-grid"
        emptyTarget="#archive-filter-empty"
        filters={allTags.map((item) => ({ value: item.tag, label: `${item.tag} · ${item.count}` }))}
        filterMode="token"
        filterParam="tag"
        searchPlaceholder="搜索标题、描述或标签…"
        urlSync
        options={[
          { value: 'default', label: '最新' },
          { value: 'alpha',   label: '首字母' },
          { value: 'date',    label: '日期' },
        ]}
      />

      <div class="grid grid--brutalist" id="posts-grid" data-pagefind-ignore>
        {allPosts.map((post, i) => (
          <div
            data-sort-name={post.data.title}
            data-sort-date={post.data.pubDate.toISOString().slice(0, 10)}
            data-sort-status={post.data.tags.join('|')}
            data-sort-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')}
          >
            <PostCard
              title={post.data.title}
              description={post.data.description}
              href={`/posts/${post.id}`}
              pubDate={post.data.pubDate}
              heroColor={post.data.heroColor}
              tags={post.data.tags}
              index={i}
            />
          </div>
        ))}
      </div>

      <div class="card card--flat archive__empty" id="archive-filter-empty" hidden>
        <p class="text-display archive__empty-title">NO MATCH</p>
        <p>没有找到匹配的文章，清除条件后再试。</p>
      </div>

      {allPosts.length === 0 && (
        <div class="card card--flat archive__empty">
          <p class="text-display archive__empty-title">EMPTY</p>
          <p>还没有任何文章。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding: var(--space-16) 0;
  }

  .archive__header {
    position: relative;
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-thick);
  }

  .archive__bg-num {
    top: -20%;
    right: 0;
  }

  .archive__count {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .archive__intro {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .archive__empty {
    text-align: center;
    padding: var(--space-16);
  }

  .archive__empty-title {
    font-size: var(--text-2xl);
  }

</style>
