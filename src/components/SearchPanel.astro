<dialog
  class="search-panel"
  id="site-search-dialog"
  aria-labelledby="site-search-title"
  data-search-dialog
>
  <div class="search-panel__sheet">
    <header class="search-panel__header">
      <div>
        <p class="search-panel__eyebrow">TorQuen / Static Index</p>
        <h2 id="site-search-title">档案检索台</h2>
      </div>
      <form method="dialog">
        <button class="search-panel__close" type="submit" aria-label="关闭搜索">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5 19 19M19 5 5 19"></path>
          </svg>
        </button>
      </form>
    </header>

    <div class="search-panel__input-wrap">
      <label for="site-search-input">搜索文章和页面</label>
      <div class="search-panel__input-line">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="site-search-input"
          type="search"
          autocomplete="off"
          placeholder="输入标题、标签或正文关键词…"
          data-search-input
        />
        <kbd>ESC</kbd>
      </div>
    </div>

    <div class="search-panel__summary">
      <p data-search-status aria-live="polite">输入关键词开始检索。</p>
      <span>↑↓ 选择 · Enter 打开</span>
    </div>

    <ol class="search-panel__results" data-search-results></ol>

    <div class="search-panel__fallback" data-search-fallback hidden>
      <strong>搜索索引暂时不可用</strong>
      <p>你仍然可以从文章归档继续浏览。</p>
      <a href="/archive">前往文章归档</a>
    </div>
  </div>
</dialog>

<style>
  .search-panel {
    width: min(1040px, calc(100vw - var(--space-16)));
    max-height: calc(100vh - var(--header-height) - var(--space-12));
    margin: calc(var(--header-height) + var(--space-6)) auto auto;
    padding: 0;
    overflow: visible;
    color: var(--color-text);
    background: transparent;
    border: 0;
  }

  .search-panel::backdrop {
    background: rgba(var(--color-border-rgb), 0.62);
  }

  .search-panel[open] {
    animation: search-panel-enter var(--dur-fast) var(--steps-small) both;
  }

  .search-panel__sheet {
    max-height: calc(100vh - var(--header-height) - var(--space-12));
    overflow-y: auto;
    padding: var(--space-8);
    background:
      linear-gradient(90deg, rgba(var(--color-border-rgb), 0.045) 1px, transparent 1px) 0 0 / 36px 36px,
      var(--color-base);
    border: var(--border-thick);
    box-shadow: var(--shadow-xl);
  }

  .search-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-thick);
  }

  .search-panel__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .search-panel__header h2 {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .search-panel__close {
    width: var(--control-height);
    height: var(--control-height);
    display: grid;
    place-items: center;
    border: var(--border-thick);
    background: var(--color-action);
    color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .search-panel__close:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md);
  }

  .search-panel__close svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }

  .search-panel__input-wrap {
    margin-top: var(--space-6);
  }

  .search-panel__input-wrap > label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
  }

  .search-panel__input-line {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border: var(--border-thick);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .search-panel__input-line:focus-within {
    box-shadow: var(--shadow-md), 8px 8px 0 0 var(--color-link);
  }

  .search-panel__input-line svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--color-link);
    stroke-width: 2.5;
  }

  .search-panel__input-line input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-lg);
  }

  .search-panel__input-line kbd {
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .search-panel__summary {
    min-height: var(--control-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .search-panel__summary p {
    margin: 0;
  }

  .search-panel__results {
    display: grid;
    gap: var(--space-3);
  }

  .search-panel__results:empty {
    display: none;
  }

  .search-panel__results :global(li) {
    list-style: none;
  }

  .search-panel__results :global(a) {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4);
    border: var(--border-thick);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .search-panel__results :global(a:hover),
  .search-panel__results :global(a:focus-visible) {
    transform: translate(-3px, -3px);
    background: var(--color-accent);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .search-panel__results :global(.search-result__kind) {
    display: inline-flex;
    justify-content: center;
    padding: var(--space-1) var(--space-2);
    background: var(--color-border);
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .search-panel__results :global(.search-result__title) {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .search-panel__results :global(.search-result__excerpt) {
    display: block;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .search-panel__results :global(.search-result__date) {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .search-panel__fallback {
    padding: var(--space-6);
    border: var(--border-thick);
    background: var(--color-paper);
  }

  .search-panel__fallback p {
    margin: var(--space-2) 0 var(--space-4);
  }

  @keyframes search-panel-enter {
    from { opacity: 0; transform: translateY(-16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-panel[open] { animation: none; }
  }
</style>

<script>
  interface PagefindData {
    url: string;
    plain_excerpt?: string;
    meta?: Record<string, string | undefined>;
  }

  interface PagefindModule {
    init: () => Promise<void> | void;
    search: (query: string) => Promise<{
      results: Array<{ data: () => Promise<PagefindData> }>;
    }>;
  }

  function initSearchPanel() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    if (!dialog || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-search-trigger]'));
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]');
    const results = dialog.querySelector<HTMLOListElement>('[data-search-results]');
    const status = dialog.querySelector<HTMLElement>('[data-search-status]');
    const fallback = dialog.querySelector<HTMLElement>('[data-search-fallback]');
    if (!input || !results || !status || !fallback) return;

    let lastTrigger: HTMLButtonElement | null = null;
    let debounceId: number | undefined;
    let requestId = 0;
    let pagefindPromise: Promise<PagefindModule> | null = null;

    const setExpanded = (expanded: boolean) => {
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', String(expanded)));
    };

    const loadPagefind = () => {
      if (!pagefindPromise) {
        pagefindPromise = (async () => {
          const modulePath = '/pagefind/pagefind.js';
          const module = await import(/* @vite-ignore */ modulePath) as PagefindModule;
          await module.init();
          return module;
        })();
      }
      return pagefindPromise;
    };

    const clearResults = () => {
      results.replaceChildren();
      fallback.hidden = true;
    };

    const appendResult = (data: PagefindData) => {
      const item = document.createElement('li');
      const link = document.createElement('a');
      const kind = document.createElement('span');
      const body = document.createElement('span');
      const title = document.createElement('strong');
      const excerpt = document.createElement('span');
      const date = document.createElement('time');
      const meta = data.meta || {};

      link.href = data.url;
      kind.className = 'search-result__kind';
      kind.textContent = meta.kind || '页面';
      title.className = 'search-result__title';
      title.textContent = meta.title || data.url;
      excerpt.className = 'search-result__excerpt';
      excerpt.textContent = meta.description || data.plain_excerpt || '打开页面查看内容。';
      body.append(title, excerpt);
      link.append(kind, body);

      if (meta.date) {
        date.className = 'search-result__date';
        date.dateTime = meta.date;
        const parsed = new Date(meta.date);
        date.textContent = Number.isNaN(parsed.getTime())
          ? meta.date
          : parsed.toLocaleDateString('zh-CN');
        link.appendChild(date);
      }

      item.appendChild(link);
      results.appendChild(item);
    };

    const runSearch = async (query: string) => {
      const normalized = query.trim();
      const currentRequest = ++requestId;
      clearResults();

      if (!normalized) {
        status.textContent = '输入关键词开始检索。';
        return;
      }

      status.textContent = '正在检索静态档案…';

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.search(normalized);
        const data = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
        if (currentRequest !== requestId) return;

        data.forEach(appendResult);
        status.textContent = search.results.length > 0
          ? '找到 ' + search.results.length + ' 条结果，显示前 ' + data.length + ' 条。'
          : '没有找到“' + normalized + '”。试试更短的关键词。';
      } catch {
        if (currentRequest !== requestId) return;
        results.replaceChildren();
        fallback.hidden = false;
        status.textContent = import.meta.env.DEV
          ? '开发模式没有生成搜索索引，请使用构建预览测试。'
          : '搜索索引加载失败。';
      }
    };

    const openDialog = (trigger: HTMLButtonElement | null) => {
      lastTrigger = trigger;
      if (!dialog.open) dialog.showModal();
      setExpanded(true);
      window.requestAnimationFrame(() => input.focus());
      loadPagefind().catch(() => undefined);
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openDialog(trigger));
    });

    input.addEventListener('input', () => {
      window.clearTimeout(debounceId);
      debounceId = window.setTimeout(() => runSearch(input.value), 150);
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      setExpanded(false);
      lastTrigger?.focus();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const links = Array.from(results.querySelectorAll<HTMLAnchorElement>('a'));
      if (links.length === 0) return;

      event.preventDefault();
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      const next = current < 0
        ? (direction > 0 ? 0 : links.length - 1)
        : (current + direction + links.length) % links.length;
      links[next]?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'k') return;
      event.preventDefault();
      if (dialog.open) {
        input.focus();
      } else {
        openDialog(document.activeElement instanceof HTMLButtonElement ? document.activeElement : null);
      }
    });
  }

  initSearchPanel();
  document.addEventListener('astro:page-load', initSearchPanel);
</script>
