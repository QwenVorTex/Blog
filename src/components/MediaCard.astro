---
import type { MediaInfo } from '@/lib/media';

interface Props {
  item: MediaInfo;
  index: number;
  coverAspect: 'poster' | 'wide';
}

const { item, index, coverAspect } = Astro.props;
const displayTitle = item.nameCn || item.name;
const originalTitle = item.nameCn && item.name !== item.nameCn ? item.name : '';
const scoreText = item.myRate > 0 ? String(item.myRate) : item.score > 0 ? item.score.toFixed(1) : 'NA';
const scoreLabel = item.myRate > 0 ? '我的评分' : item.score > 0 ? 'Bangumi 评分' : '暂无评分';
const searchText = [item.name, item.nameCn, item.year, item.collectionType, ...item.tags].filter(Boolean).join(' ');
const rotation = [-0.4, 0.3, -0.7, 0.5, -0.2, 0.1][index % 6];
---

<a
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['media-card', `media-card--${coverAspect}`, `media-card--${item.statusTone ?? 'neutral'}`, 'scroll-reveal']}
  style={`--media-rotate: ${rotation}deg;`}
  data-sort-name={item.label}
  data-sort-search={searchText}
  data-sort-date={item.date || item.year}
  data-sort-score={item.myRate || item.score || 0}
  data-sort-status={item.collectionType}
>
  <div class="media-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <div class="media-card__cover">
    {item.cover ? (
      <img
        src={item.cover}
        alt={`${displayTitle} 封面`}
        loading="lazy"
        decoding="async"
        class="media-card__img"
      />
    ) : (
      <div class="media-card__fallback" aria-label={`${displayTitle} 无封面`}>{displayTitle.charAt(0)}</div>
    )}
    <span class="media-card__year">{item.year || '----'}</span>
    <span class="media-card__score" aria-label={scoreLabel}>{scoreText}</span>
  </div>
  <div class="media-card__body">
    <div class="media-card__status-row">
      <span class="media-card__status">{item.collectionType || '未知'}</span>
      {item.rank > 0 && <span class="media-card__rank">#{item.rank}</span>}
    </div>
    <h3 class="media-card__name">{displayTitle}</h3>
    {originalTitle && <p class="media-card__label">{originalTitle}</p>}
    {item.tags.length > 0 && (
      <div class="media-card__tags" aria-label="标签">
        {item.tags.slice(0, 3).map((tag) => (
          <span class="media-card__tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .media-card {
    --status-color: var(--color-border);
    display: block;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-thick);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
    transform: rotate(var(--media-rotate, 0deg));
    transition:
      transform var(--dur-fast) var(--steps-small),
      box-shadow var(--dur-fast) var(--steps-small),
      background-color var(--dur-instant) var(--steps-micro);
  }

  .media-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 9px;
    background: var(--status-color);
    z-index: 2;
  }

  .media-card--done { --status-color: var(--color-accent); }
  .media-card--doing { --status-color: var(--color-action); }
  .media-card--wish { --status-color: var(--color-link); }
  .media-card--paused { --status-color: var(--color-text-muted); }

  .media-card:hover {
    color: var(--color-text);
    text-decoration: none;
    transform: rotate(0deg) translate(-5px, -5px);
    box-shadow:
      14px 14px 0 0 var(--color-border),
      7px 7px 0 0 var(--status-color);
  }

  .media-card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 var(--color-border);
  }

  .media-card__index {
    position: absolute;
    top: var(--space-2);
    left: var(--space-4);
    z-index: 3;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    padding: 2px var(--space-2);
    background: var(--color-border);
    color: var(--color-surface);
    border: var(--border-thin);
  }

  .media-card__cover {
    position: relative;
    border-bottom: var(--border-thick);
    background:
      linear-gradient(135deg, rgba(var(--color-border-rgb), 0.08) 25%, transparent 25%) -10px 0 / 20px 20px,
      var(--color-base);
    overflow: hidden;
  }

  .media-card--poster .media-card__cover {
    aspect-ratio: 4 / 5;
  }

  .media-card--wide .media-card__cover {
    aspect-ratio: 16 / 10;
  }

  .media-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.04);
    transition: transform var(--dur-slow) var(--steps-large), filter var(--dur-fast) var(--steps-small);
  }

  .media-card:hover .media-card__img {
    transform: scale(1.04);
    filter: saturate(1.12) contrast(1.08);
  }

  .media-card__fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 900;
    color: var(--color-text-muted);
  }

  .media-card__year,
  .media-card__score {
    position: absolute;
    z-index: 3;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    border: var(--border-medium);
    background: var(--color-surface);
    color: var(--color-text);
    line-height: 1;
  }

  .media-card__year {
    right: var(--space-2);
    top: var(--space-2);
    padding: var(--space-1) var(--space-2);
  }

  .media-card__score {
    right: var(--space-2);
    bottom: var(--space-2);
    min-width: 2.5rem;
    padding: var(--space-2);
    text-align: center;
    background: var(--color-accent);
    box-shadow: 3px 3px 0 0 var(--color-border);
  }

  .media-card__body {
    padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 9px);
  }

  .media-card__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .media-card__status {
    color: var(--color-text);
    font-weight: 800;
  }

  .media-card__rank {
    white-space: nowrap;
  }

  .media-card__name {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2);
    border: none;
    padding: 0;
    text-transform: none;
  }

  .media-card__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .media-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .media-card__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 1px var(--space-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: rgba(var(--color-border-rgb), 0.03);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .media-card {
      transform: none;
    }
  }
</style>
