---
import { siteConfig } from '@/config/site';

const year = new Date().getFullYear();
const socialLinks = [
  { label: 'GitHub', href: siteConfig.social.github },
  { label: 'X', href: siteConfig.social.x },
  { label: 'Bilibili', href: siteConfig.social.bilibili },
].filter((item) => item.href);
---

<footer class="site-footer">
  <!-- Static archive ticker -->
  <div class="marquee-track">
    <div class="marquee-content site-footer__ticker">
      <span>NEO-BRUTALIST BLOG ✦</span>
      <span>反设计 ◆ ANTI-DESIGN ■</span>
      <span>粗野主义 ▲ BRUTALISM ✦</span>
    </div>
  </div>

  <div class="site-footer__inner container">
    <div class="site-footer__grid">
      <!-- Column 1 -->
      <div class="site-footer__col">
        <div class="site-footer__logo">
          <span class="site-footer__logo-block"></span>
          <span class="site-footer__logo-text">{siteConfig.shortName}</span>
        </div>
        <p class="site-footer__desc">
          {siteConfig.description}
        </p>
      </div>

      <!-- Column 2 -->
      <div class="site-footer__col">
        <h4 class="site-footer__heading">导航</h4>
        {siteConfig.navigation.primary.map((item) => (
          <a href={item.href} class="site-footer__link">{item.label}</a>
        ))}
      </div>

      <!-- Column 3 -->
      <div class="site-footer__col">
        <h4 class="site-footer__heading">链接</h4>
        <a href="/rss.xml" class="site-footer__link">RSS 订阅</a>
        {socialLinks.map((item) => (
          <a href={item.href} class="site-footer__link" target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
        ))}
        {socialLinks.length === 0 && <p class="site-footer__note">真实社交链接待补充。</p>}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="text-label">© {year} · Built with Astro · {siteConfig.shortName}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-thick);
    background: var(--color-base);
    margin-top: var(--space-16);
  }

  .site-footer__ticker {
    justify-content: space-around;
    flex-wrap: wrap;
    white-space: normal;
    animation: none;
  }

  .site-footer__inner {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-10);
  }

  .site-footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .site-footer__logo-block {
    width: 24px;
    height: 24px;
    background: var(--color-border);
    transition: transform var(--dur-fast) var(--steps-small);
  }

  .site-footer__logo:hover .site-footer__logo-block {
    transform: rotate(45deg);
  }

  .site-footer__logo-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 900;
    text-transform: uppercase;
  }

  .site-footer__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 35ch;
  }

  .site-footer__heading {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-medium);
  }

  .site-footer__link {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-1) 0;
    transition: color var(--dur-instant) step-end;
  }

  .site-footer__link:hover {
    color: var(--color-action);
    text-decoration: none;
  }

  .site-footer__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .site-footer__bottom {
    border-top: var(--border-medium);
    padding-top: var(--space-6);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
