---
/**
 * SortControls — 粗野主义风格的排序 + 筛选 + 搜索控件
 * 客户端：状态筛选 + 搜索过滤 + 排序 + 正反序切换
 */
interface Props {
  target: string;
  emptyTarget?: string;
  options?: Array<{ value: string; label: string }>;
  filters?: Array<{ value: string; label: string }>;
  external?: boolean;
  urlSync?: boolean;
  filterMode?: 'exact' | 'token';
  filterParam?: string;
  searchPlaceholder?: string;
}

const { target, emptyTarget, options = [
  { value: 'default', label: '默认' },
  { value: 'alpha',   label: '首字母' },
  { value: 'date',    label: '时间' },
],
  filters = [],
  external = false,
  urlSync = false,
  filterMode = 'exact',
  filterParam = 'filter',
  searchPlaceholder = '搜索标题、年份、标签…',
} = Astro.props;
---

<div
  class="sort-controls scroll-reveal"
  data-sort-target={target}
  data-sort-empty-target={emptyTarget}
  data-sort-external={external ? 'true' : undefined}
  data-sort-url-sync={urlSync ? 'true' : undefined}
  data-sort-filter-mode={filterMode}
  data-sort-filter-param={filterParam}
  data-pagefind-ignore
>
  {filters.length > 0 && (
    <div class="sort-controls__row sort-controls__row--filters">
      <span class="sort-controls__label">筛选</span>
      <div class="sort-controls__btns" role="group" aria-label="筛选条目状态">
        <button
          class="sort-controls__btn is-active"
          data-filter-value=""
          type="button"
          aria-pressed="true"
        >
          全部
        </button>
        {filters.map((f) => (
          <button
            class="sort-controls__btn"
            data-filter-value={f.value}
            type="button"
            aria-pressed="false"
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>
  )}
  <div class="sort-controls__row">
    <span class="sort-controls__label">排序</span>
    <div class="sort-controls__btns" role="group" aria-label="排序方式">
      {options.map((opt, i) => (
        <button
          class:list={['sort-controls__btn', { 'is-active': i === 0 }]}
          data-sort-value={opt.value}
          type="button"
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {opt.label}
        </button>
      ))}
    </div>
    <button
      class="sort-controls__btn sort-controls__order"
      data-sort-order="desc"
      title="切换排序方向"
      type="button"
      aria-label="切换排序方向，当前为降序"
    >
      ↓
    </button>
  </div>
  <div class="sort-controls__search-row">
    <input
      class="sort-controls__search"
      type="search"
      placeholder={searchPlaceholder}
      data-sort-search
      aria-label="搜索条目"
    />
    <button class="sort-controls__clear" type="button" data-sort-clear hidden>
      清除条件
    </button>
    <span class="sort-controls__count" data-sort-count aria-live="polite"></span>
  </div>
</div>

<style>
  .sort-controls {
    margin-bottom: var(--space-8);
  }

  .sort-controls__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .sort-controls__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .sort-controls__btns {
    display: flex;
    gap: 0;
  }

  .sort-controls__btn {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: var(--space-2) var(--space-4);
    min-height: var(--control-height);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border-thick);
    cursor: pointer;
    transition: transform var(--dur-instant) var(--steps-micro),
                box-shadow var(--dur-instant) var(--steps-micro),
                background-color var(--dur-instant) var(--steps-micro),
                color var(--dur-instant) var(--steps-micro),
                border-color var(--dur-instant) var(--steps-micro);
    margin-left: -4px;
    white-space: nowrap;
  }

  .sort-controls__btn:first-child {
    margin-left: 0;
  }

  .sort-controls__btn:hover {
    background: var(--color-accent);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
    position: relative;
    z-index: 1;
  }

  .sort-controls__btn.is-active {
    background: var(--color-border);
    color: var(--color-surface);
    z-index: 1;
    position: relative;
  }

  .sort-controls__btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px 0px var(--color-border);
  }

  .sort-controls__order {
    min-width: 2.2rem;
    text-align: center;
    font-size: var(--text-sm);
  }

  .sort-controls__order[data-sort-order="asc"] {
    color: var(--color-action);
  }

  .sort-controls__search-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sort-controls__search {
    flex: 1;
    max-width: 360px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    min-height: var(--control-height);
    background: var(--color-surface);
    border: var(--border-thick);
    color: var(--color-text);
    outline: none;
    transition: transform var(--dur-instant) var(--steps-micro),
                box-shadow var(--dur-instant) var(--steps-micro);
  }

  .sort-controls__search:focus {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm), 4px 4px 0px 0px var(--color-link);
    border-color: var(--color-link);
  }

  .sort-controls__search::placeholder {
    color: var(--color-text-muted);
  }

  .sort-controls__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .sort-controls__clear {
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-4);
    border: var(--border-thick);
    background: var(--color-accent);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .sort-controls__clear:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md);
  }

  .sort-controls__clear[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .sort-controls__row {
      align-items: flex-start;
    }

    .sort-controls__row--filters .sort-controls__btns,
    .sort-controls__row .sort-controls__btns {
      overflow-x: auto;
      padding: 0 0 var(--space-2);
      scrollbar-width: thin;
    }

    .sort-controls__row--filters,
    .sort-controls__row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .sort-controls__search-row {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-2);
    }

    .sort-controls__search {
      max-width: 100%;
    }
  }
</style>

<script>
  import type { SortState } from '@/lib/sort';

  function initSortControls() {
    document.querySelectorAll<HTMLElement>('.sort-controls').forEach((ctrl) => {
      if (ctrl.dataset.sortReady === 'true') return;
      ctrl.dataset.sortReady = 'true';

      const targetSelector = ctrl.dataset.sortTarget;
      if (!targetSelector) return;
      const container = document.querySelector<HTMLElement>(targetSelector);
      if (!container) return;
      const sortContainer = container;
      const externalMode = ctrl.dataset.sortExternal === 'true';
      const urlSync = ctrl.dataset.sortUrlSync === 'true';
      const filterMode = ctrl.dataset.sortFilterMode || 'exact';
      const filterParam = ctrl.dataset.sortFilterParam || 'filter';

      const emptyEl = ctrl.dataset.sortEmptyTarget
        ? document.querySelector<HTMLElement>(ctrl.dataset.sortEmptyTarget)
        : null;
      const allItems = Array.from(container.children) as HTMLElement[];
      allItems.forEach((el, i) => el.dataset.sortOriginal = String(i));

      const sortButtons = ctrl.querySelectorAll<HTMLButtonElement>('.sort-controls__btn[data-sort-value]');
      const filterButtons = ctrl.querySelectorAll<HTMLButtonElement>('.sort-controls__btn[data-filter-value]');
      const orderBtn = ctrl.querySelector<HTMLButtonElement>('.sort-controls__order');
      const searchInput = ctrl.querySelector<HTMLInputElement>('.sort-controls__search');
      const countEl = ctrl.querySelector<HTMLElement>('.sort-controls__count');
      const clearButton = ctrl.querySelector<HTMLButtonElement>('[data-sort-clear]');

      const defaultMode = sortButtons[0]?.dataset.sortValue || 'default';
      const getDefaultAscending = (mode: string) => mode === 'alpha';

      let currentMode = defaultMode;
      let ascending = getDefaultAscending(defaultMode);
      let searchQuery = '';
      let activeFilter = '';

      function emitState() {
        const detail: SortState = {
          mode: currentMode,
          ascending,
          searchQuery,
          activeFilter,
        };
        ctrl.dispatchEvent(new CustomEvent('sort-controls:change', {
          bubbles: true,
          detail,
        }));
      }

      function updateCount(visible: number, total: number) {
        if (countEl) {
          countEl.textContent = visible === total ? `${total} 项` : `${visible} / ${total}`;
        }
        if (emptyEl) {
          emptyEl.hidden = total === 0 || visible !== 0;
        }
      }

      function updateControls() {
        sortButtons.forEach((button) => {
          const isActive = button.dataset.sortValue === currentMode;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
        filterButtons.forEach((button) => {
          const isActive = (button.dataset.filterValue || '') === activeFilter;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
        if (searchInput) searchInput.value = searchQuery;
        if (orderBtn) {
          orderBtn.dataset.sortOrder = ascending ? 'asc' : 'desc';
          orderBtn.textContent = ascending ? '↑' : '↓';
          orderBtn.setAttribute('aria-label', `切换排序方向，当前为${ascending ? '升序' : '降序'}`);
        }
        if (clearButton) {
          clearButton.hidden = (
            currentMode === defaultMode
            && ascending === getDefaultAscending(defaultMode)
            && !searchQuery
            && !activeFilter
          );
        }
      }

      function syncUrl(mode: 'replace' | 'push') {
        if (!urlSync) return;
        const url = new URL(window.location.href);

        if (currentMode === defaultMode) url.searchParams.delete('sort');
        else url.searchParams.set('sort', currentMode);

        if (ascending === getDefaultAscending(currentMode)) url.searchParams.delete('order');
        else url.searchParams.set('order', ascending ? 'asc' : 'desc');

        if (searchQuery) url.searchParams.set('q', searchQuery);
        else url.searchParams.delete('q');

        if (activeFilter) url.searchParams.set(filterParam, activeFilter);
        else url.searchParams.delete(filterParam);

        if (url.toString() === window.location.href) return;
        window.history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
      }

      function readUrlState() {
        if (!urlSync) return;
        const params = new URLSearchParams(window.location.search);
        const requestedMode = params.get('sort') || defaultMode;
        currentMode = Array.from(sortButtons).some((button) => button.dataset.sortValue === requestedMode)
          ? requestedMode
          : defaultMode;
        const requestedOrder = params.get('order');
        ascending = requestedOrder
          ? requestedOrder === 'asc'
          : getDefaultAscending(currentMode);
        searchQuery = params.get('q')?.trim() || '';
        const requestedFilter = params.get(filterParam) || '';
        activeFilter = Array.from(filterButtons).some(
          (button) => (button.dataset.filterValue || '') === requestedFilter,
        ) ? requestedFilter : '';
      }

      function applySortAndFilter(historyMode?: 'replace' | 'push') {
        updateControls();
        if (historyMode) syncUrl(historyMode);

        if (externalMode) {
          emitState();
          return;
        }

        const query = searchQuery.toLowerCase();

        let visibleCount = 0;
        allItems.forEach((el) => {
          const searchText = (el.dataset.sortSearch || el.dataset.sortName || '').toLowerCase();
          const status = el.dataset.sortStatus || '';
          const nameMatch = !query || searchText.includes(query);
          const statusMatch = !activeFilter || (
            filterMode === 'token'
              ? status.split('|').includes(activeFilter)
              : status === activeFilter
          );
          const visible = nameMatch && statusMatch;
          el.hidden = !visible;
          if (visible) visibleCount++;
        });

        const visibleItems = allItems.filter((el) => !el.hidden);
        const hiddenItems = allItems.filter((el) => el.hidden);

        let sorted: HTMLElement[];

        switch (currentMode) {
          case 'alpha':
            sorted = [...visibleItems].sort((a, b) => {
              const cmp = (a.dataset.sortName || '').toLowerCase().localeCompare(
                (b.dataset.sortName || '').toLowerCase(), 'zh-CN'
              );
              return ascending ? cmp : -cmp;
            });
            break;

          case 'date':
            sorted = [...visibleItems].sort((a, b) => {
              const cmp = (a.dataset.sortDate || '0').localeCompare(b.dataset.sortDate || '0');
              return ascending ? cmp : -cmp;
            });
            break;

          case 'score':
            sorted = [...visibleItems].sort((a, b) => {
              const cmp = (Number(a.dataset.sortScore) || 0) - (Number(b.dataset.sortScore) || 0);
              return ascending ? cmp : -cmp;
            });
            break;

          default:
            sorted = [...visibleItems].sort((a, b) => {
              const cmp = Number(a.dataset.sortOriginal) - Number(b.dataset.sortOriginal);
              return ascending ? -cmp : cmp;
            });
            break;
        }

        sorted.forEach((el) => sortContainer.appendChild(el));
        hiddenItems.forEach((el) => sortContainer.appendChild(el));

        updateCount(visibleCount, allItems.length);
      }

      sortButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentMode = btn.dataset.sortValue || 'default';
          ascending = getDefaultAscending(currentMode);
          applySortAndFilter('push');
        });
      });

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeFilter = btn.dataset.filterValue || '';
          applySortAndFilter('push');
        });
      });

      if (orderBtn) {
        orderBtn.addEventListener('click', () => {
          ascending = !ascending;
          applySortAndFilter('push');
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          searchQuery = searchInput.value.trim();
          applySortAndFilter('replace');
        });
      }

      clearButton?.addEventListener('click', () => {
        currentMode = defaultMode;
        ascending = getDefaultAscending(defaultMode);
        searchQuery = '';
        activeFilter = '';
        applySortAndFilter('push');
        searchInput?.focus();
      });

      if (urlSync) {
        window.addEventListener('popstate', () => {
          readUrlState();
          applySortAndFilter();
        });
        readUrlState();
      }

      applySortAndFilter();
    });
  }

  initSortControls();
  document.addEventListener('astro:after-swap', initSortControls);
</script>
