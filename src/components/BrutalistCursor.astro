---
---

<div
  class="brutalist-cursor"
  id="brutalist-cursor"
  aria-hidden="true"
  data-mode="default"
  data-zone="default"
  data-pressed="false"
>
  <div class="brutalist-cursor__shadow" id="cursor-shadow"></div>
  <div class="brutalist-cursor__core" id="cursor-core">
    <div class="brutalist-cursor__core-mark"></div>
  </div>
</div>

<div class="cursor-hud" id="cursor-hud" aria-hidden="true">
  <span class="cursor-hud__text" id="cursor-hud-text"></span>
</div>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    html.has-brutalist-cursor body,
    html.has-brutalist-cursor a,
    html.has-brutalist-cursor button,
    html.has-brutalist-cursor [role='button'],
    html.has-brutalist-cursor .card,
    html.has-brutalist-cursor .post-card,
    html.has-brutalist-cursor .media-card,
    html.has-brutalist-cursor .tag,
    html.has-brutalist-cursor .home-hero__block,
    html.has-brutalist-cursor .hero__block {
      cursor: none !important;
    }

    html.has-brutalist-cursor .post__content,
    html.has-brutalist-cursor .post__content *,
    html.has-brutalist-cursor .search-panel,
    html.has-brutalist-cursor .search-panel * {
      cursor: auto !important;
    }

    html.has-brutalist-cursor :is(input, textarea, [contenteditable='true']) {
      cursor: text !important;
    }

    html.has-brutalist-cursor .post__content a,
    html.has-brutalist-cursor .search-panel :is(a, button) {
      cursor: pointer !important;
    }

    body:has(.search-panel[open]) .brutalist-cursor,
    body:has(.search-panel[open]) .cursor-hud {
      opacity: 0 !important;
    }
  }

  body {
    position: relative;
  }

  #scroll-container {
    position: relative;
    z-index: 1;
  }

  /* ── Core marker / stamp ── */
  .brutalist-cursor {
    position: fixed;
    inset: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--steps-small);
  }

  .brutalist-cursor.is-active {
    opacity: 1;
  }

  .brutalist-cursor__shadow,
  .brutalist-cursor__core {
    position: fixed;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    will-change: transform;
  }

  .brutalist-cursor__shadow {
    background: var(--color-border);
    opacity: 0.9;
    transition:
      width var(--dur-fast) var(--steps-small),
      height var(--dur-fast) var(--steps-small),
      opacity var(--dur-fast) var(--steps-small);
  }

  .brutalist-cursor__core {
    border: var(--border-thick);
    background: var(--color-accent);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      width var(--dur-fast) var(--steps-small),
      height var(--dur-fast) var(--steps-small),
      background-color var(--dur-instant) var(--steps-micro),
      box-shadow var(--dur-fast) var(--steps-small),
      border-color var(--dur-instant) var(--steps-micro);
  }

  .brutalist-cursor__core-mark {
    width: 8px;
    height: 8px;
    background: var(--color-border);
    transition:
      width var(--dur-fast) var(--steps-small),
      height var(--dur-fast) var(--steps-small),
      background-color var(--dur-instant) var(--steps-micro);
  }

  .brutalist-cursor[data-mode='link'] .brutalist-cursor__shadow {
    width: 34px;
    height: 34px;
    opacity: 0.3;
  }

  .brutalist-cursor[data-mode='link'] .brutalist-cursor__core {
    width: 34px;
    height: 34px;
    background: transparent;
    box-shadow: none;
  }

  .brutalist-cursor[data-mode='link'] .brutalist-cursor__core-mark {
    width: 6px;
    height: 6px;
  }

  .brutalist-cursor[data-mode='button'] .brutalist-cursor__shadow {
    width: 34px;
    height: 34px;
  }

  .brutalist-cursor[data-mode='button'] .brutalist-cursor__core {
    width: 34px;
    height: 34px;
    background: var(--color-accent);
    box-shadow: 10px 10px 0px 0px var(--color-action);
  }

  .brutalist-cursor[data-mode='button'] .brutalist-cursor__core-mark {
    width: 12px;
    height: 12px;
    background: var(--color-action);
  }

  .brutalist-cursor[data-mode='card'] .brutalist-cursor__shadow {
    width: 46px;
    height: 28px;
    opacity: 0.42;
  }

  .brutalist-cursor[data-mode='card'] .brutalist-cursor__core {
    width: 46px;
    height: 28px;
    background: var(--color-surface);
    box-shadow: 8px 8px 0px 0px var(--color-link);
  }

  .brutalist-cursor[data-mode='card'] .brutalist-cursor__core-mark {
    width: 18px;
    height: 4px;
    background: var(--color-link);
  }

  .brutalist-cursor[data-zone='reading'][data-mode='default'] .brutalist-cursor__shadow {
    width: 22px;
    height: 22px;
    opacity: 0.78;
  }

  .brutalist-cursor[data-zone='reading'][data-mode='default'] .brutalist-cursor__core {
    width: 22px;
    height: 22px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .brutalist-cursor[data-zone='reading'][data-mode='default'] .brutalist-cursor__core-mark {
    width: 6px;
    height: 6px;
  }

  .brutalist-cursor[data-pressed='true'] .brutalist-cursor__core {
    box-shadow: 2px 2px 0px 0px var(--color-border);
  }

  .brutalist-cursor[data-pressed='true'][data-mode='button'] .brutalist-cursor__core {
    box-shadow: 2px 2px 0px 0px var(--color-action);
  }

  .brutalist-cursor[data-pressed='true'][data-mode='card'] .brutalist-cursor__core {
    box-shadow: 2px 2px 0px 0px var(--color-link);
  }

  /* ── HUD positioning label (trail) ── */
  .cursor-hud {
    position: fixed;
    left: 0;
    top: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity var(--dur-fast) var(--steps-small);
  }

  .cursor-hud.is-active {
    opacity: 1;
  }

  .cursor-hud__text {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 3px 3px 0px 0px var(--color-border);
    transition:
      background-color var(--dur-instant) var(--steps-micro),
      color var(--dur-instant) var(--steps-micro),
      box-shadow var(--dur-fast) var(--steps-small);
  }

  .cursor-hud[data-mode='link'] .cursor-hud__text {
    background: var(--color-link);
    color: var(--color-surface);
    box-shadow: 3px 3px 0px 0px var(--color-border);
  }

  .cursor-hud[data-mode='button'] .cursor-hud__text {
    background: var(--color-action);
    color: var(--color-surface);
    box-shadow: 3px 3px 0px 0px var(--color-border);
  }

  .cursor-hud[data-mode='card'] .cursor-hud__text {
    background: var(--color-accent);
    color: var(--color-border);
    box-shadow: 3px 3px 0px 0px var(--color-border);
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .brutalist-cursor,
    .cursor-hud {
      display: none !important;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __brutalistCursorReady?: boolean;
    }
  }

  function initBrutalistCursor() {
    if (window.__brutalistCursorReady) return;

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!finePointer || reducedMotion) return;

    const root = document.getElementById('brutalist-cursor');
    const core = document.getElementById('cursor-core');
    const shadow = document.getElementById('cursor-shadow');
    const hud = document.getElementById('cursor-hud');
    const hudText = document.getElementById('cursor-hud-text');

    if (!root || !core || !shadow || !hud || !hudText) return;

    window.__brutalistCursorReady = true;
    document.documentElement.classList.add('has-brutalist-cursor');

    const HUD_OFFSET_X = 22;
    const HUD_OFFSET_Y = 22;
    const IDLE_TIMEOUT = 400;

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let coreX = targetX;
    let coreY = targetY;
    let shadowX = targetX;
    let shadowY = targetY;
    let hudX = targetX;
    let hudY = targetY;
    let visible = false;
    let pressed = false;
    let mode = 'default';
    let zone = 'default';
    let lastLabel = '';
    let idleTimer = 0;
    let draggingScrollbar = false;
    let scrollbarDragOffsetY = 0;

    const lerp = (current: number, target: number, factor: number) =>
      current + (target - current) * factor;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), max);

    const getVerticalScrollbarBounds = () => {
      const gutterWidth = window.innerWidth - document.documentElement.clientWidth;
      if (gutterWidth <= 0) return null;

      return {
        left: document.documentElement.clientWidth,
        width: gutterWidth,
      };
    };

    const getVerticalScrollbarThumb = () => {
      const bounds = getVerticalScrollbarBounds();
      const scrollHeight = document.documentElement.scrollHeight;
      const viewportHeight = window.innerHeight;
      const maxScroll = scrollHeight - viewportHeight;

      if (!bounds || maxScroll <= 0) return null;

      const height = Math.max(24, (viewportHeight / scrollHeight) * viewportHeight);
      const travel = viewportHeight - height;
      const top = (window.scrollY / maxScroll) * travel;

      return {
        top,
        height,
        x: bounds.left + bounds.width / 2,
      };
    };

    const isVerticalScrollbarEvent = (event: PointerEvent | MouseEvent) => {
      const bounds = getVerticalScrollbarBounds();
      return Boolean(bounds && event.clientX >= bounds.left && event.clientX <= window.innerWidth);
    };

    const syncWithVerticalScrollbar = () => {
      const thumb = getVerticalScrollbarThumb();
      if (!thumb) return;

      targetX = thumb.x;
      targetY = clamp(thumb.top + scrollbarDragOffsetY, 0, window.innerHeight);
      mode = 'default';
      zone = 'default';
      setVisibility(true);
      hud.classList.remove('is-active');
    };

    const startScrollbarDrag = (event: PointerEvent | MouseEvent) => {
      const thumb = getVerticalScrollbarThumb();

      pressed = true;
      draggingScrollbar = true;
      scrollbarDragOffsetY = thumb ? clamp(event.clientY - thumb.top, 0, thumb.height) : 0;
      syncWithVerticalScrollbar();
    };

    const setVisibility = (nextVisible: boolean) => {
      visible = nextVisible;
      const customVisible = visible && zone !== 'reading' && zone !== 'native';
      root.classList.toggle('is-active', customVisible);
      const hudVisible = customVisible;
      hud.classList.toggle('is-active', hudVisible);
    };

    const resolveMode = (element: Element | null) => {
      if (!element) return 'default';
      if (
        element.closest(
          'button, [role="button"], .btn, .sort-controls__btn, .sort-controls__clear'
        )
      ) {
        return 'button';
      }
      if (
        element.closest(
          '.post-card, .media-card, .about__quick-card, .home-hero__block, .hero__block, .card'
        )
      ) {
        return 'card';
      }
      if (element.closest('a, .tag')) {
        return 'link';
      }
      return 'default';
    };

    const resolveZone = (element: Element | null) => {
      if (!element) return 'default';
      if (element.closest('[data-search-dialog]')) return 'native';
      if (element.closest('[data-cursor-zone="reading"]')) return 'reading';
      if (element.closest('[data-cursor-zone="hero"]')) return 'hero';
      return 'default';
    };

    const resolveLabel = () => {
      if (mode === 'link') return '->OPEN';
      if (mode === 'button') return '->CLICK';
      if (mode === 'card') return '->VIEW';
      return `[x:${Math.round(targetX)} y:${Math.round(targetY)}]`;
    };

    let frameId: number | null = null;

    const render = () => {
      const coreFactor = draggingScrollbar
        ? 0.5
        : pressed
        ? 0.16
        : mode === 'button'
          ? 0.18
          : mode === 'card'
            ? 0.2
            : mode === 'link'
              ? 0.24
              : 0.28;
      const shadowFactor = draggingScrollbar ? 0.28 : pressed ? 0.08 : mode === 'card' ? 0.1 : 0.12;
      const hudFactor = draggingScrollbar ? 0.35 : 0.14;

      coreX = lerp(coreX, targetX, coreFactor);
      coreY = lerp(coreY, targetY, coreFactor);
      shadowX = lerp(shadowX, targetX, shadowFactor);
      shadowY = lerp(shadowY, targetY, shadowFactor);
      hudX = lerp(hudX, targetX, hudFactor);
      hudY = lerp(hudY, targetY, hudFactor);

      core.style.transform = `translate3d(${coreX}px, ${coreY}px, 0) translate(-50%, -50%)`;
      shadow.style.transform = `translate3d(${shadowX + 6}px, ${shadowY + 6}px, 0) translate(-50%, -50%)`;
      hud.style.transform = `translate3d(${hudX + HUD_OFFSET_X}px, ${hudY + HUD_OFFSET_Y}px, 0)`;

      const label = resolveLabel();
      if (label !== lastLabel) {
        hudText.textContent = label;
        lastLabel = label;
      }

      root.dataset.mode = mode;
      root.dataset.zone = zone;
      root.dataset.pressed = String(pressed);
      hud.dataset.mode = mode;

      const unsettled = (
        Math.abs(coreX - targetX) > 0.1
        || Math.abs(coreY - targetY) > 0.1
        || Math.abs(shadowX - targetX) > 0.1
        || Math.abs(shadowY - targetY) > 0.1
        || Math.abs(hudX - targetX) > 0.1
        || Math.abs(hudY - targetY) > 0.1
      );
      frameId = unsettled || pressed || draggingScrollbar
        ? window.requestAnimationFrame(render)
        : null;
    };

    const scheduleRender = () => {
      if (frameId === null) {
        frameId = window.requestAnimationFrame(render);
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType && event.pointerType !== 'mouse') return;

      if (draggingScrollbar) {
        syncWithVerticalScrollbar();
        return;
      }

      if (isVerticalScrollbarEvent(event)) {
        targetX = event.clientX;
        targetY = event.clientY;
        mode = 'default';
        zone = 'default';
        setVisibility(true);
        hud.classList.remove('is-active');
        scheduleRender();
        return;
      }

      targetX = event.clientX;
      targetY = event.clientY;

      const target = event.target instanceof Element ? event.target : null;
      mode = resolveMode(target);
      zone = resolveZone(target);
      setVisibility(true);
      scheduleRender();

      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        hud.classList.remove('is-active');
      }, IDLE_TIMEOUT);
    };

    const onPointerDown = (event: PointerEvent) => {
      if (event.pointerType && event.pointerType !== 'mouse') return;

      pressed = true;
      scheduleRender();

      if (isVerticalScrollbarEvent(event)) {
        startScrollbarDrag(event);
      }
    };

    const onPointerUp = () => {
      pressed = false;
      draggingScrollbar = false;
      scheduleRender();
    };

    const onMouseDown = (event: MouseEvent) => {
      if (!draggingScrollbar && isVerticalScrollbarEvent(event)) {
        startScrollbarDrag(event);
      }
    };

    const onScroll = () => {
      if (draggingScrollbar) {
        syncWithVerticalScrollbar();
        scheduleRender();
      }
    };

    const hideCursor = () => {
      window.clearTimeout(idleTimer);
      setVisibility(false);
      pressed = false;
      draggingScrollbar = false;
      mode = 'default';
      zone = 'default';
    };

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('pointerdown', onPointerDown, { passive: true });
    window.addEventListener('pointerup', onPointerUp, { passive: true });
    window.addEventListener('mousedown', onMouseDown, { passive: true, capture: true });
    window.addEventListener('mouseup', onPointerUp, { passive: true, capture: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('blur', hideCursor);
    document.documentElement.addEventListener('mouseleave', hideCursor);

    scheduleRender();
  }

  initBrutalistCursor();
  document.addEventListener('astro:page-load', initBrutalistCursor);
</script>
