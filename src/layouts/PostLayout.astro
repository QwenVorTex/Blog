---
import BaseLayout from './BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import { siteConfig } from '@/config/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroColor?: 'yellow' | 'red' | 'blue' | 'black';
  tags?: string[];
  readingMinutes?: number;
  ogImage?: string;
  keywords?: string[];
  canonical?: string;
  hasToc?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroColor = 'yellow',
  tags = [],
  readingMinutes = 1,
  ogImage,
  keywords = [],
  canonical,
  hasToc = false,
} = Astro.props;

const colorMap = {
  yellow: 'var(--color-accent)',
  red: 'var(--color-action)',
  blue: 'var(--color-link)',
  black: 'var(--color-border)',
};

const heroBackground = colorMap[heroColor];
const textColor = heroColor === 'black' || heroColor === 'red' ? 'var(--color-surface)' : 'var(--color-text)';

const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdate = updatedDate?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const resolvedSiteURL = Astro.site ?? new URL(siteConfig.url);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: siteConfig.locale,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: siteConfig.author.name,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.author.name,
  },
  image: ogImage ? [new URL(ogImage, resolvedSiteURL).toString()] : undefined,
  keywords: [...new Set([...keywords, ...tags])],
  mainEntityOfPage: canonical || new URL(Astro.url.pathname, resolvedSiteURL).toString(),
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  pageType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate || pubDate).toISOString()}
  keywords={[...new Set([...keywords, ...tags])]}
  canonical={canonical}
  structuredData={articleStructuredData}
>
  <article class="post">
    <div class="post-progress" data-reading-progress data-pagefind-ignore>
      <progress max="100" value="0" aria-label="文章阅读进度" data-reading-progress-bar></progress>
      <div class="post-progress__meta">
        <span data-reading-progress-value>0%</span>
        <span class="post-progress__chapter" data-reading-chapter>文章开头</span>
      </div>
    </div>

    <header class="post__hero" style={`background: ${heroBackground}; color: ${textColor};`}>
      <div class="container">
        <a class="post__back text-label" href="/archive">返回归档</a>
        <div class="post__meta text-label anim-enter">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>· {readingMinutes} 分钟阅读</span>
          {updatedDate && <span>· 更新于 {formattedUpdate}</span>}
        </div>
        <h1 class="post__title anim-enter anim-delay-1">{title}</h1>
        <p class="post__desc anim-enter anim-delay-2">{description}</p>
        {tags.length > 0 && (
          <div class="post__tags anim-enter anim-delay-3">
            {tags.map((tag) => (
              <Tag label={tag} href={`/archive?tag=${encodeURIComponent(tag)}`} />
            ))}
          </div>
        )}
      </div>
    </header>

    <div
      class:list={['post__body', 'container', { 'container--narrow': !hasToc, 'post__body--with-toc': hasToc }]}
      data-cursor-zone="reading"
    >
      <div class="post__body-grid">
        <div class="post__content">
          <slot />
        </div>
        {hasToc && (
          <aside class="post__toc" aria-label="文章目录">
            <slot name="toc" />
          </aside>
        )}
      </div>
      <slot name="afterContent" />
    </div>
  </article>
</BaseLayout>

<style>
  .post__back {
    display: inline-flex;
    margin-bottom: var(--space-5);
    color: inherit;
  }

  .post__back:hover {
    color: inherit;
  }

  .post__hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: var(--border-thick);
  }

  .post__meta {
    margin-bottom: var(--space-4);
    opacity: 0.8;
  }

  .post__title {
    font-size: var(--text-4xl);
    max-width: 14ch;
    margin-bottom: var(--space-4);
    border-bottom: none;
    padding-bottom: 0;
  }

  .post__desc {
    font-size: var(--text-lg);
    max-width: 50ch;
    opacity: 0.9;
    margin-bottom: var(--space-6);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post__body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .post-progress {
    position: sticky;
    top: var(--header-height);
    z-index: calc(var(--z-header) - 1);
    height: 30px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
    border-bottom: var(--border-medium);
    background: var(--color-border);
    color: var(--color-surface);
  }

  .post-progress progress {
    width: 100%;
    height: 8px;
    appearance: none;
    border: var(--border-thin);
    border-color: var(--color-surface);
    background: transparent;
  }

  .post-progress progress::-webkit-progress-bar {
    background: transparent;
  }

  .post-progress progress::-webkit-progress-value {
    background: var(--color-accent);
  }

  .post-progress progress::-moz-progress-bar {
    background: var(--color-accent);
  }

  .post-progress__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    white-space: nowrap;
  }

  .post-progress__chapter {
    max-width: 30ch;
    overflow: hidden;
    color: var(--color-accent);
    text-overflow: ellipsis;
  }

  .post__body--with-toc {
    max-width: var(--max-width);
  }

  .post__body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-10);
    align-items: start;
    width: 100%;
    max-width: calc(var(--content-width) + 260px + var(--space-10));
    margin-inline: auto;
  }

  .container--narrow .post__body-grid {
    display: block;
  }

  .post__content {
    font-size: var(--text-base);
    line-height: 1.78;
    min-width: 0;
  }

  .post__content :global(p) {
    margin-bottom: var(--space-6);
  }

  .post__content :global(a) {
    word-break: break-word;
  }

  .post__content :global(blockquote) {
    margin: var(--space-8) 0;
    background: var(--color-paper);
    font-style: normal;
  }

  .post__content :global(pre) {
    margin: var(--space-8) 0;
    position: relative;
  }

  .post__copy-button {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin);
    background: var(--color-accent);
    color: var(--color-border);
    box-shadow: 3px 3px 0 0 var(--color-border);
  }

  .post__copy-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  .post__toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    padding: var(--space-4);
    border: var(--border-thick);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .post__toc :global(.post-toc__title) {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 900;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .post__toc :global(ol) {
    display: grid;
    gap: var(--space-2);
  }

  .post__toc :global(a) {
    display: block;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text);
    text-decoration: none;
  }

  .post__toc :global(a:hover) {
    color: var(--color-action);
    text-decoration: underline;
  }

  .post__toc :global(a[aria-current='location']) {
    margin-left: calc(-1 * var(--space-2));
    padding: var(--space-2);
    background: var(--color-accent);
    color: var(--color-text);
    box-shadow: 3px 3px 0 0 var(--color-border);
    text-decoration: none;
  }

  .post__toc :global(.post-toc__item--3) {
    padding-left: var(--space-4);
  }

  .post__content :global(figcaption) {
    margin-top: calc(-1 * var(--space-5));
    margin-bottom: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .post__content :global(h2) {
    margin-top: var(--space-12);
  }

  .post__content :global(h3) {
    margin-top: var(--space-8);
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .post__content :global(ul) {
    list-style: square;
  }

  .post__content :global(ol) {
    list-style: decimal;
  }

  .post__content :global(li) {
    margin-bottom: var(--space-2);
  }

  .post__content :global(img) {
    border: var(--border-thick);
    box-shadow: var(--shadow-lg);
    margin: var(--space-8) 0;
  }

  .post__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    border: var(--border-thick);
    margin: var(--space-6) 0;
    box-shadow: var(--shadow-md);
  }

  .post__content :global(th) {
    background: var(--color-border);
    color: var(--color-surface);
    font-weight: 800;
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border: var(--border-thin);
    border-color: var(--color-text-muted);
  }

  .post__content :global(td) {
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin);
    font-size: var(--text-sm);
  }

  .post__content :global(tr:nth-child(even)) {
    background: rgba(var(--color-border-rgb), 0.03);
  }

  @media (max-width: 768px) {
    .post__hero {
      padding: var(--space-10) 0 var(--space-8);
    }
    .post__title {
      font-size: var(--text-3xl);
      max-width: 100%;
    }

    .post__body {
      padding-top: var(--space-8);
    }

    .post__body-grid {
      display: block;
    }

    .post__toc {
      display: none;
    }

    .post__content {
      line-height: 1.7;
    }
  }

  @media (max-width: 1023px) {
    .post-progress {
      display: none;
    }
  }
</style>

<script>
  function initPostCodeCopy() {
    document.querySelectorAll<HTMLElement>('.post__content pre').forEach((pre) => {
      if (pre.dataset.copyReady === 'true') return;
      const code = pre.querySelector('code');
      if (!code?.textContent) return;
      pre.dataset.copyReady = 'true';

      const button = document.createElement('button');
      button.className = 'post__copy-button';
      button.type = 'button';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          button.textContent = '已复制';
          window.setTimeout(() => {
            button.textContent = '复制';
          }, 1400);
        } catch {
          button.textContent = '复制失败';
          window.setTimeout(() => {
            button.textContent = '复制';
          }, 1400);
        }
      });

      pre.appendChild(button);
    });
  }

  initPostCodeCopy();
  document.addEventListener('astro:page-load', initPostCodeCopy);

  function initReadingProgress() {
    const post = document.querySelector<HTMLElement>('.post');
    if (!post || post.dataset.readingReady === 'true') return;
    post.dataset.readingReady = 'true';

    const content = post.querySelector<HTMLElement>('.post__content');
    const progress = post.querySelector<HTMLProgressElement>('[data-reading-progress-bar]');
    const value = post.querySelector<HTMLElement>('[data-reading-progress-value]');
    const chapter = post.querySelector<HTMLElement>('[data-reading-chapter]');
    if (!content || !progress || !value || !chapter) return;

    const tocLinks = Array.from(post.querySelectorAll<HTMLAnchorElement>('.post__toc a[href^="#"]'));
    const headings = Array.from(content.querySelectorAll<HTMLElement>('h2[id], h3[id]'));
    const linkById = new Map(
      tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]),
    );
    let frameId: number | null = null;
    let observer: IntersectionObserver | null = null;

    const setActiveHeading = (id: string | undefined) => {
      tocLinks.forEach((link) => link.removeAttribute('aria-current'));
      if (!id) {
        chapter.textContent = '文章开头';
        return;
      }

      const activeLink = linkById.get(id);
      activeLink?.setAttribute('aria-current', 'location');
      const activeHeading = headings.find((heading) => heading.id === id);
      chapter.textContent = activeHeading?.textContent?.trim() || '正文';
    };

    const updateProgress = () => {
      frameId = null;
      const headerOffset = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--header-height'),
      ) || 72;
      const rect = content.getBoundingClientRect();
      const start = window.scrollY + rect.top - headerOffset - 30;
      const end = start + content.offsetHeight - window.innerHeight + headerOffset + 30;
      const ratio = end <= start
        ? Number(window.scrollY >= start)
        : Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
      const percentage = Math.round(ratio * 100);
      progress.value = percentage;
      value.textContent = percentage + '%';
    };

    const queueProgressUpdate = () => {
      if (frameId !== null) return;
      frameId = window.requestAnimationFrame(updateProgress);
    };

    if ('IntersectionObserver' in window && headings.length > 0) {
      const visible = new Set<string>();
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const heading = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(heading.id);
          else visible.delete(heading.id);
        });

        const visibleHeading = headings.find((heading) => visible.has(heading.id));
        if (visibleHeading) {
          setActiveHeading(visibleHeading.id);
          return;
        }

        const passedHeading = [...headings]
          .reverse()
          .find((heading) => heading.getBoundingClientRect().top <= 150);
        setActiveHeading(passedHeading?.id);
      }, {
        rootMargin: '-110px 0px -68% 0px',
        threshold: [0, 1],
      });
      headings.forEach((heading) => observer?.observe(heading));
    }

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setActiveHeading(decodeURIComponent(link.hash.slice(1)));
      });
    });

    window.addEventListener('scroll', queueProgressUpdate, { passive: true });
    window.addEventListener('resize', queueProgressUpdate);
    queueProgressUpdate();
    setActiveHeading(decodeURIComponent(window.location.hash.slice(1)) || headings[0]?.id);

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', queueProgressUpdate);
      window.removeEventListener('resize', queueProgressUpdate);
      if (frameId !== null) window.cancelAnimationFrame(frameId);
      observer?.disconnect();
    }, { once: true });
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
</script>



